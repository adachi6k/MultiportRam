# Multi-Port RAM Configuration
# This file can be sourced by scripts to set consistent parameters

# Default design parameters
DEFAULT_WIDTH=32
DEFAULT_DEPTH=32
DEFAULT_RD_NUM=2
DEFAULT_WR_NUM=2

# Simulation parameters
SIM_TIME=1000
CLOCK_PERIOD=10

# Test configurations
TEST_CONFIGS="small medium large"

# Small configuration
SMALL_WIDTH=8
SMALL_DEPTH=16
SMALL_RD_NUM=1
SMALL_WR_NUM=1

# Medium configuration  
MEDIUM_WIDTH=32
MEDIUM_DEPTH=64
MEDIUM_RD_NUM=2
MEDIUM_WR_NUM=2

# Large configuration
LARGE_WIDTH=64
LARGE_DEPTH=256
LARGE_RD_NUM=4
LARGE_WR_NUM=4

# Synthesis tool settings
SYNTH_TOOL=yosys
TARGET_TECH=sky130

# Verification settings
FORMAL_TOOL=sby
COVERAGE_ENABLED=1
